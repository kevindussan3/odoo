<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accion cliente para el dashboard -->
    <record id="kitchen_custom_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard de Cocina</field>
        <field name="tag">kitchen_custom_dashboard_tags</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- Accion principal para Pantallas de Cocina -->
    <record id="kitchen_screen_action" model="ir.actions.act_window">
        <field name="name">Pantallas de Cocina</field>
        <field name="res_model">x_kitchen.screen</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="kitchen_screen_view_tree"/>
    </record>



    <!-- Vista Lista -->
    <record id="kitchen_screen_view_tree" model="ir.ui.view">
        <field name="name">x_kitchen.screen.view.tree</field>
        <field name="model">x_kitchen.screen</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" string="Referencia"/>
                <field name="pos_config_id" string="Punto de Venta"/>
            </list>
        </field>
    </record>
</odoo>